{
  "manifest_version": 3,
  "name": "Keel: Browser Copilot",
  "description": "A screen aware, human in the loop copilot for the forms that keep asking who you are: signups, checkouts, registrations, and job applications.",
  "version": "0.4.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "sidePanel", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Keel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["webmcp-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
