{
  "manifest_version": 3,
  "name": "Keel — Job Application Copilot",
  "description": "A screen-aware, human-directed copilot for job application forms.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Keel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
