{
  "manifest_version": 3,
  "name": "Keel: Browser Copilot",
  "description": "A voice-first, screen-aware, human-in-the-loop copilot for every form that asks who you are: signups, checkouts, registrations, and job applications.",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Keel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["webmcp-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
